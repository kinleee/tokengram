# ChromaDB verilənlər bazası
chroma_db/
# Backup snapshots of broken/migrated DBs
chroma_db.broken-*/
# Corruption quarantine (db_guard auto-renames a corrupt DB aside) + marker
chroma_db.corrupt-*/
*.quarantine_pending

# API açarları
.env

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.eggs/

# Cython build artefaktları (öz biznes modullarımız .pyd-ə kompil olunur)
*.c
*.pyd
*.so
dist_compiled/
nuitka_build/
nuitka_build.log

# Virtual mühit
venv/
.venv/
env/

# IDE (root only — vscode-extension/.vscode/ contains shared dev config)
/.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Hash store
.file_hashes.json

# Model cache
models_cache/

# MLA Agent hook növbəsi
.mla_pending.txt
.mla_pending.processing

# MLA Agent sessiya analytics log
.mla_session_log.jsonl

# MLA Agent per-task qənaət tarixçəsi (per-machine, push olunmamalıdır)
.mla_savings_history.jsonl
.mla_savings_history.jsonl.bak*

# MLA Read-enforcement runtime state (per-machine)
.mla_enforcement.flag

# MLA Auto-generated arch doc + state (per-machine, accumulates from session_log)
.mla_arch.md
.mla_arch_state.json

# Tokengram BM25 keyword index (rebuildable from chroma_db in seconds)
.bm25_index.pkl

# Tokengram process locks + handoff markers (transient, per-machine)
.tokengram.writer.lock
.tokengram.drainer.lock
.tokengram.leader.lock
.tokengram.reindex.want
.tokengram.*.lock.tmp.*

# Tokengram DB self-heal health event (status-bar diagnostic)
.mla_db_health.json

# Tokengram session-log atomic-flush temp (Stop hook rename target)
.mla_session_log.jsonl.processing.*

# Müvəqqəti append/edit faylları
_tmp_*.md

# .mcp.json backups (setupWizard hər yenidən yazanda .bak-<ts> yaradır — per-machine)
.mcp.json.bak*

# Claude Code lokal/şəxsi tənzimləmələr (settings.json paylaşılır)
.claude/settings.local.json

# PyPI wheel build artifacts — tokengram/ is populated by build_pypi.py
# from compiled .pyd + hooks + messages. Only __init__.py and __main__.py
# (the shim) are tracked.
tokengram/*.pyd
tokengram/*.so
tokengram/server.py
tokengram/hooks/*.py
!tokengram/hooks/__init__.py
tokengram/messages/

# Cython MSVC compilation intermediates (regenerated every build)
build_tmp/
*.obj
*.exp
*.lib

# .pyd backups left behind when Windows file-locking forces a rename-swap
*.pyd.bak
*.pyd.lockedbak
*.pyd.lock2

# VSIX builds (rebuildable via `vsce package`; release artifacts go to GitHub
# Releases or the Marketplace, not the repo)
vscode-extension/*.vsix
_install_simulate/

# Node deps (admin/license servers — restored via `npm ci` on the box)
node_modules/

# >>> Tokengram (auto-managed) — runtime artifacts, do not commit >>>
chroma_db/
chroma_db.broken-*/
chroma_db.corrupt-*/
.bm25_index.pkl
.file_hashes.json
.mla_pending.txt
.mla_pending.processing
.mla_session_log.jsonl
.mla_session_log.jsonl.processing.*
.mla_savings_history.jsonl
.mla_savings_history.jsonl.bak.*
.mla_enforcement.flag
.mla_arch.md
.mla_arch_state.json
.mla_db_health.json
.tokengram.writer.lock
.tokengram.drainer.lock
.tokengram.leader.lock
.tokengram.reindex.want
.tokengram.*.lock.tmp.*
*.quarantine_pending
# <<< Tokengram (auto-managed) <<<
