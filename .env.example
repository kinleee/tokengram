# ============================================
# API Açarları — .env-ə kopyala və real açar qoy
# ============================================
# DİQQƏT: .env faylı .gitignore-dadır, commit olunmur.
#
# Claude Code istifadə edirsənsə (MCP üzərindən), API açarı LAZIM DEYİL.
# Bu açarlar yalnız aşağıdakılar üçün lazımdır:
#   - python main.py ask "..."   (CLI üzərindən sual vermək)
#   - decompose_query funksiyası (alt-suallara bölünmə)

# Anthropic Claude API açarı (https://console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI GPT API açarı (https://platform.openai.com)
OPENAI_API_KEY=your_openai_api_key_here

# Default LLM provider: "anthropic" və ya "openai"
LLM_PROVIDER=anthropic
