# Tokengram admin server — config.
# Bu faylı `.env` adı ilə kopyala və qiymətləri yaz.

# HTTP port
PORT=3000

# SQLite database path
DB_PATH=./data/tokengram.db

# JWT açarları (PEM). license-server/keys/-dən kopyalanır.
JWT_PRIVATE_KEY_PATH=./keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt_public.pem

# Admin bootstrap (yalnız ilk işə düşəndə istifadə olunur).
# Admin yarandıqdan sonra bu sətirləri silə bilərsən.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Session imza açarı (random uzun string yaz).
SESSION_SECRET=
