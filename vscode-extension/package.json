{
  "name": "tokengram",
  "displayName": "Tokengram",
  "description": "Token-saving memory layer for Claude Code — hybrid RAG search over your project (local; up to 70% on search/Read-heavy tasks, less on edit-heavy refactors).",
  "version": "0.1.76",
  "publisher": "tokengram",
  "license": "SEE LICENSE IN LICENSE.txt",
  "icon": "icon.png",
  "homepage": "https://github.com/kinleee/tokengram",
  "repository": {
    "type": "git",
    "url": "https://github.com/kinleee/tokengram.git"
  },
  "bugs": {
    "email": "n.ilkin.humbatov@gmail.com"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Machine Learning",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "claude",
    "claude-code",
    "mcp",
    "rag",
    "ai",
    "memory",
    "token-savings",
    "code-search",
    "embeddings",
    "anthropic"
  ],
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "tokengram.menu",
        "title": "Tokengram: Open menu",
        "category": "Tokengram"
      },
      {
        "command": "tokengram.setup",
        "title": "Tokengram: Run setup wizard",
        "category": "Tokengram"
      }
    ],
    "configuration": {
      "title": "Tokengram",
      "properties": {
        "tokengram.autoInstallHooks": {
          "type": "boolean",
          "default": false,
          "description": "Automatically write .claude/settings.json on workspace open without prompting."
        },
        "tokengram.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Override Python interpreter (leave empty to auto-detect)."
        },
        "tokengram.licenseServerUrl": {
          "type": "string",
          "default": "https://tokengram.click",
          "description": "License-server endpoint."
        },
        "tokengram.devRoot": {
          "type": "string",
          "default": "",
          "description": "Path to the Tokengram source tree (folder containing main.py). Used by the Re-index button until a production CLI ships in the wheel."
        }
      }
    },
    "configurationDefaults": {
      "files.exclude": {
        "**/.tokengram.writer.lock": true,
        "**/.tokengram.drainer.lock": true,
        "**/.tokengram.leader.lock": true,
        "**/.tokengram.reindex.want": true,
        "**/.tokengram.*.lock.tmp.*": true,
        "**/.bm25_index.pkl": true,
        "**/.file_hashes.json": true,
        "**/.mla_db_health.json": true,
        "**/.mla_enforcement.flag": true,
        "**/.mla_pending.txt": true,
        "**/.mla_pending.processing": true,
        "**/.mla_session_log.jsonl": true,
        "**/.mla_session_log.jsonl.processing.*": true,
        "**/.mla_savings_history.jsonl": true,
        "**/.mla_savings_history.jsonl.bak.*": true,
        "**/.mla_arch.md": true,
        "**/.mla_arch_state.json": true,
        "**/chroma_db": true,
        "**/chroma_db.broken-*": true,
        "**/chroma_db.corrupt-*": true
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build:prod",
    "build": "node esbuild.config.js",
    "build:prod": "node esbuild.config.js --prod",
    "watch": "node esbuild.config.js --watch",
    "compile-check": "tsc --noEmit",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0"
  }
}
